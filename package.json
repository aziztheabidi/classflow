{
  "name": "edukat-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "mobile"
  ],
  "scripts": {
    "install:backend": "npm --prefix backend install",
    "install:mobile": "npm --prefix mobile install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:mobile": "npm --prefix mobile run start",
    "build:backend": "npm --prefix backend run build",
    "test:backend": "npm --prefix backend run test",
    "typecheck:mobile": "npm --prefix mobile run typecheck"
  }
}
